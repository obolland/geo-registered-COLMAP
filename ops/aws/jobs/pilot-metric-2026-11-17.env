# Default-strategy pilot trained in metres (no world normalisation, near plane 1 cm): the previous pilot's
# normalised near plane (0.01 units, about 1.2 m) clipped near geometry. The PLY is then in the session ENU
# frame. Built into one job with: cat this file ops/aws/train-pilot.sh
export MAX_STEPS=30000
export TRAIN_TIMEOUT_MIN=80
export VARIANTS='metric|default|--no-normalize_world_space --near_plane 0.01'
