# Combined pilot: default strategy, metric frame, factor-2 images, prune-after-refine,
# scale-aware 0.7 m path-tube prune, sparse-depth supervision. One 30k variant.
# Factor-2 images live in images_2 (generate/upload before the run). Depth loss uses the
# sparse COLMAP points projected into each training image; 0.005 is half the upstream
# default and keeps the disparity term secondary to photometric loss.
export MAX_STEPS=30000
export DATA_FACTOR=2
export NEAR_PRUNE_M=0.5
export TRAIN_TIMEOUT_MIN=150
export MAX_MINUTES=200
export VARIANTS='combined|default|--no-normalize_world_space --near_plane 0.01 --depth-loss --depth-lambda 0.005'
