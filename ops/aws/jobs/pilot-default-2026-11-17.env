# Full pilot with gsplat's default (adaptive density control) strategy, after the MCMC run diverged (see
# research/reviews/slice8-part1-review.md). 30k steps, held-out evaluation at 10k/20k/30k, checkpoints and
# PLYs every 5k. Built into one job with: cat this file ops/aws/train-pilot.sh
export MAX_STEPS=30000
export TRAIN_TIMEOUT_MIN=80
export VARIANTS='default|default|'
