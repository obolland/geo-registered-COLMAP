# Diagnostic session after pilot attempt 2 diverged: four 3k-step variants on block s160-l100, compared on
# held-out PSNR/SSIM/LPIPS at step 3000. Built into one job with: cat this file ops/aws/train-pilot.sh
export MAX_STEPS=3000
export TRAIN_TIMEOUT_MIN=36
export VARIANTS='mcmc|mcmc|--strategy.cap-max 1000000
default|default|
mcmc-metric|mcmc|--strategy.cap-max 1000000 --no-normalize_world_space
default-app|default|--app_opt'
