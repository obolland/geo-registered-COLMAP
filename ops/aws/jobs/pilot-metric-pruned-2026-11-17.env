# Default-strategy pilot in metres, with prune-after-refine and a 1.0 m near-camera centre
# prune. One variant, 30k steps, 195 minute training timeout inside the 240 minute hard cap.
# NEAR_PRUNE_M is passed as --strategy.near-prune-m and recorded in results/near-prune.json.
export MAX_STEPS=30000
export TRAIN_TIMEOUT_MIN=195
export VARIANTS='metric-pruned|default|--no-normalize_world_space --near_plane 0.01'
export NEAR_PRUNE_M=1.0
