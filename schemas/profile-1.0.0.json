{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/obolland/geo-registered-COLMAP/schemas/profile-1.0.0.json",
  "title": "georoute distance profile",
  "description": "One-metre route-global primitives. Heights are orthometric and name their geoid in the route manifest; grade is percent rise over horizontal run. Compatibility: 1.y minor versions only add optional fields, so readers must ignore unknown fields; required fields and their meanings do not change within 1.x.",
  "type": "object",
  "required": ["schema", "seg_id", "s_range", "samples"],
  "properties": {
    "schema": {"const": "georoute.profile/1.0.0"},
    "seg_id": {"type": "string", "pattern": "^seg_[0-9]{4}$"},
    "s_range": {"$ref": "#/$defs/s_range"},
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sample"}
    }
  },
  "$defs": {
    "s_range": {
      "type": "array",
      "prefixItems": [{"type": "number", "minimum": 0}, {"type": "number", "minimum": 0}],
      "minItems": 2,
      "maxItems": 2
    },
    "sample": {
      "type": "object",
      "required": [
        "s",
        "s_h",
        "lat",
        "lon",
        "h_ortho",
        "sigma_h",
        "grade",
        "curvature",
        "corridor_left_m",
        "corridor_right_m",
        "surface",
        "quality"
      ],
      "properties": {
        "s": {"type": "number", "minimum": 0},
        "s_h": {"type": "number", "minimum": 0},
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180},
        "h_ortho": {"type": "number"},
        "sigma_h": {"type": "number", "minimum": 0},
        "grade": {"type": "number"},
        "curvature": {"type": "number"},
        "corridor_left_m": {"type": "number", "minimum": 0},
        "corridor_right_m": {"type": "number", "minimum": 0},
        "surface": {"type": "string", "minLength": 1},
        "quality": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Known values: rtk-float, rtk-none, time-recovered, bridged-gap, surface-nominal."
          }
        }
      }
    }
  }
}
